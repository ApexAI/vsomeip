+
+#ifndef BOOST_ASIO_DETAIL_IMPL_QNX_POLL_REACTOR_IPP
+#define BOOST_ASIO_DETAIL_IMPL_QNX_POLL_REACTOR_IPP
+
+#include <boost/asio/detail/config.hpp>
+
+#if defined(BOOST_ASIO_HAS_QNX_POLL)
+
+#include <poll.h>
+#include <vector>
+#include <boost/asio/detail/hash_map.hpp>
+#include <boost/asio/detail/qnx_poll_reactor.hpp>
+#include <boost/asio/detail/scheduler.hpp>
+
+#include <boost/asio/detail/push_options.hpp>
+
+namespace boost {
+namespace asio {
+namespace detail {
+
+qnx_poll_reactor::qnx_poll_reactor(boost::asio::execution_context& ctx)
+  : execution_context_service_base<qnx_poll_reactor>(ctx),
+    scheduler_(use_service<scheduler>(ctx)),
+    mutex_(),
+    interrupter_(),
+    shutdown_(false)
+{
+}
+
+qnx_poll_reactor::~qnx_poll_reactor()
+{
+  shutdown();
+}
+
+void qnx_poll_reactor::shutdown()
+{
+  boost::asio::detail::mutex::scoped_lock lock(mutex_);
+  shutdown_ = true;
+  lock.unlock();
+
+  op_queue<operation> ops;
+  for (int i = 0; i < max_ops; ++i)
+    op_queue_[i].get_all_operations(ops);
+  timer_queues_.get_all_timers(ops);
+  scheduler_.abandon_operations(ops);
+}
+
+void qnx_poll_reactor::notify_fork(
+    boost::asio::execution_context::fork_event fork_ev)
+{
+  if (fork_ev == boost::asio::execution_context::fork_child)
+    interrupter_.recreate();
+}
+
+void qnx_poll_reactor::init_task()
+{
+  scheduler_.init_task();
+}
+
+int qnx_poll_reactor::register_descriptor(socket_type,
+    qnx_poll_reactor::per_descriptor_data&)
+{
+  return 0;
+}
+
+int qnx_poll_reactor::register_internal_descriptor(
+    int op_type, socket_type descriptor,
+    qnx_poll_reactor::per_descriptor_data&, reactor_op* op)
+{
+  boost::asio::detail::mutex::scoped_lock lock(mutex_);
+  op_queue_[op_type].enqueue_operation(descriptor, op);
+  interrupter_.interrupt();
+  return 0;
+}
+
+void qnx_poll_reactor::move_descriptor(socket_type,
+    qnx_poll_reactor::per_descriptor_data&,
+    qnx_poll_reactor::per_descriptor_data&)
+{
+}
+
+void qnx_poll_reactor::call_post_immediate_completion(
+    operation* op, bool is_continuation, const void* self)
+{
+  static_cast<const qnx_poll_reactor*>(self)->post_immediate_completion(
+      op, is_continuation);
+}
+
+void qnx_poll_reactor::start_op(int op_type, socket_type descriptor,
+    qnx_poll_reactor::per_descriptor_data&, reactor_op* op,
+    bool is_continuation, bool,
+    void (*on_immediate)(operation*, bool, const void*),
+    const void* immediate_arg)
+{
+  boost::asio::detail::mutex::scoped_lock lock(mutex_);
+
+  if (shutdown_)
+  {
+    on_immediate(op, is_continuation, immediate_arg);
+    return;
+  }
+
+  bool first = op_queue_[op_type].enqueue_operation(descriptor, op);
+  scheduler_.work_started();
+  if (first)
+    interrupter_.interrupt();
+}
+
+void qnx_poll_reactor::cancel_ops(socket_type descriptor,
+    qnx_poll_reactor::per_descriptor_data&)
+{
+  boost::asio::detail::mutex::scoped_lock lock(mutex_);
+  cancel_ops_unlocked(descriptor, boost::asio::error::operation_aborted);
+}
+
+void qnx_poll_reactor::cancel_ops_by_key(socket_type descriptor,
+    qnx_poll_reactor::per_descriptor_data&,
+    int op_type, void* cancellation_key)
+{
+  boost::asio::detail::mutex::scoped_lock lock(mutex_);
+  op_queue<operation> ops;
+  bool need_interrupt = op_queue_[op_type].cancel_operations_by_key(
+      descriptor, ops, cancellation_key, boost::asio::error::operation_aborted);
+  scheduler_.post_deferred_completions(ops);
+  if (need_interrupt)
+    interrupter_.interrupt();
+}
+
+void qnx_poll_reactor::deregister_descriptor(socket_type descriptor,
+    qnx_poll_reactor::per_descriptor_data&, bool)
+{
+  boost::asio::detail::mutex::scoped_lock lock(mutex_);
+  cancel_ops_unlocked(descriptor, boost::asio::error::operation_aborted);
+}
+
+void qnx_poll_reactor::deregister_internal_descriptor(
+    socket_type descriptor, qnx_poll_reactor::per_descriptor_data&)
+{
+  boost::asio::detail::mutex::scoped_lock lock(mutex_);
+  op_queue<operation> ops;
+  for (int i = 0; i < max_ops; ++i)
+    op_queue_[i].cancel_operations(descriptor, ops);
+}
+
+void qnx_poll_reactor::cleanup_descriptor_data(
+    qnx_poll_reactor::per_descriptor_data&)
+{
+}
+
+void qnx_poll_reactor::run(long usec, op_queue<operation>& ops)
+{
+  boost::asio::detail::mutex::scoped_lock lock(mutex_);
+
+  bool have_work_to_do = !timer_queues_.all_empty();
+  for (int i = 0; i < max_ops; ++i)
+    have_work_to_do = have_work_to_do || !op_queue_[i].empty();
+
+  if (!usec && !have_work_to_do)
+    return;
+
+  std::vector< ::pollfd> events;
+  hash_map<socket_type, std::size_t> event_index;
+
+  ::pollfd interrupter_event = { 0, 0, 0 };
+  interrupter_event.fd = interrupter_.read_descriptor();
+  interrupter_event.events = POLLIN;
+  events.push_back(interrupter_event);
+  event_index.insert(std::make_pair(interrupter_event.fd, 0));
+
+  static const short event_masks[max_ops] = { POLLIN, POLLOUT, POLLPRI };
+  for (int op_type = 0; op_type < max_ops; ++op_type)
+  {
+    reactor_op_queue<socket_type>::iterator i = op_queue_[op_type].begin();
+    while (i != op_queue_[op_type].end())
+    {
+      socket_type descriptor = i->first;
+      hash_map<socket_type, std::size_t>::iterator index =
+        event_index.find(descriptor);
+      if (index == event_index.end())
+      {
+        ::pollfd event = { 0, 0, 0 };
+        event.fd = descriptor;
+        event.events = event_masks[op_type];
+        std::size_t new_index = events.size();
+        events.push_back(event);
+        event_index.insert(std::make_pair(descriptor, new_index));
+      }
+      else
+      {
+        events[index->second].events |= event_masks[op_type];
+      }
+      ++i;
+    }
+  }
+
+  int timeout = 0;
+  if (usec != 0)
+  {
+    timeout = (usec < 0) ? -1 : static_cast<int>((usec - 1) / 1000 + 1);
+    timeout = get_timeout(timeout);
+  }
+
+  lock.unlock();
+  int num_events = ::poll(&events[0], events.size(), timeout);
+
+  if (num_events > 0 && events[0].revents != 0)
+  {
+    if (!interrupter_.reset())
+      interrupter_.recreate();
+  }
+
+  lock.lock();
+
+  if (num_events > 0)
+  {
+    for (std::size_t i = 1; i < events.size(); ++i)
+    {
+      short revents = events[i].revents;
+      if (revents == 0)
+        continue;
+
+      socket_type descriptor = events[i].fd;
+
+      // Process exception operations first so out-of-band data is handled
+      // before normal data.
+      if (revents & (POLLPRI | POLLERR | POLLHUP | POLLNVAL))
+        op_queue_[except_op].perform_operations(descriptor, ops);
+
+      if (revents & (POLLIN | POLLERR | POLLHUP | POLLNVAL))
+        op_queue_[read_op].perform_operations(descriptor, ops);
+
+      if (revents & (POLLOUT | POLLERR | POLLHUP | POLLNVAL))
+        op_queue_[write_op].perform_operations(descriptor, ops);
+    }
+  }
+
+  timer_queues_.get_ready_timers(ops);
+}
+
+void qnx_poll_reactor::interrupt()
+{
+  interrupter_.interrupt();
+}
+
+void qnx_poll_reactor::do_add_timer_queue(timer_queue_base& queue)
+{
+  mutex::scoped_lock lock(mutex_);
+  timer_queues_.insert(&queue);
+}
+
+void qnx_poll_reactor::do_remove_timer_queue(timer_queue_base& queue)
+{
+  mutex::scoped_lock lock(mutex_);
+  timer_queues_.erase(&queue);
+}
+
+int qnx_poll_reactor::get_timeout(int msec)
+{
+  const int max_msec = 5 * 60 * 1000;
+  return timer_queues_.wait_duration_msec(
+      (msec < 0 || max_msec < msec) ? max_msec : msec);
+}
+
+void qnx_poll_reactor::cancel_ops_unlocked(socket_type descriptor,
+    const boost::system::error_code& ec)
+{
+  bool need_interrupt = false;
+  op_queue<operation> ops;
+  for (int i = 0; i < max_ops; ++i)
+    need_interrupt = op_queue_[i].cancel_operations(
+        descriptor, ops, ec) || need_interrupt;
+  scheduler_.post_deferred_completions(ops);
+  if (need_interrupt)
+    interrupter_.interrupt();
+}
+
